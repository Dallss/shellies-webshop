# Generate with: npx auth secret
AUTH_SECRET=
# Google OAuth client (Google Cloud Console > APIs & Services > Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated Google emails allowed into /admin
ADMIN_EMAILS=dallss.dev@gmail.com
