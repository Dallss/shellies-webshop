# Generate with: npx auth secret
AUTH_SECRET=
# Google OAuth client (Google Cloud Console > APIs & Services > Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated Google emails allowed into /admin
ADMIN_EMAILS=dallss.dev@gmail.com
# Only needed when running `next start` locally; Vercel and `next dev` trust the host automatically
# AUTH_TRUST_HOST=true

# Supabase (added by the Vercel Supabase integration; `vercel env pull .env.local` fills these)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Used only by `npm run db:migrate` (runs automatically during Vercel builds)
POSTGRES_URL_NON_POOLING=
